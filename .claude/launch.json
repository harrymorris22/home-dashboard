{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "loft_climate/backend/.venv/bin/uvicorn",
      "runtimeArgs": [
        "app.main:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--app-dir",
        "loft_climate/backend"
      ],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "loft_climate/frontend"],
      "port": 5173
    }
  ]
}
